# ─── Server ─────────────────────────────────────
RATELIMITERX_SERVER_PORT=8080
RATELIMITERX_SERVER_MODE=release

# ─── MySQL ──────────────────────────────────────
RATELIMITERX_DATABASE_HOST=mysql
RATELIMITERX_DATABASE_PORT=3306
RATELIMITERX_DATABASE_USER=root
RATELIMITERX_DATABASE_PASSWORD=change-me
RATELIMITERX_DATABASE_NAME=ratelimiterx

# ─── Redis ───────────────────────────────────────
RATELIMITERX_REDIS_ADDR=redis:6379
RATELIMITERX_REDIS_PASSWORD=
RATELIMITERX_REDIS_DB=0

# ─── JWT ─────────────────────────────────────────
RATELIMITERX_JWT_ACCESS_SECRET=change-this-access-secret
RATELIMITERX_JWT_REFRESH_SECRET=change-this-refresh-secret